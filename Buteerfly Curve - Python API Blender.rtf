\f0\fs24 \cf0 import bpy\
import math\
\
# Parameters\
points = 5000       # More points = smoother curve\
scale = 0.2        # Adjust size to fit viewport\
height_scale = 0.1 # Optional: Adds slight 3D variation\
\
curve_points = []\
for i in range(points):\
    t = i / (points - 1)  # Normalized [0, 1]\
    angle = t * 24 * math.pi  # Angle in radians (adjust multiplier for more "wings")\
    \
    # Correct Butterfly Curve formula\
    r = math.exp(math.sin(angle)) - 2 * math.cos(4 * angle) + (math.sin((2 * angle - math.pi) / 24)) ** 5\
    x = scale * r * math.exp(math.sin(angle)) \
    y = scale * r * math.exp(math.cos(angle)) \
    z = height_scale * math.sin(angle)  # Optional: Adds slight 3D depth\
    \
    curve_points.append((x, y, z))\
\
# Create the curve\
curve_data = bpy.data.curves.new('newcurve', type='CURVE')\
curve_data.dimensions = '3D'\
curve_data.resolution_u = 32  # Smoothness\
\
# Use BEZIER spline for smooth interpolation\
spline = curve_data.splines.new('BEZIER')\
spline.bezier_points.add(len(curve_points) - 1)\
\
# Assign points with auto-handles for smoothness\
for i, (x, y, z) in enumerate(curve_points):\
    point = spline.bezier_points[i]\
    point.co = (x, y, z)\
    point.handle_left_type = 'AUTO'  # Smooth handles\
    point.handle_right_type = 'AUTO'\
\
#Add to scene\
curve_obj = bpy.data.objects.new('newcurve', curve_data)\
bpy.context.collection.objects.link(curve_obj)\
}